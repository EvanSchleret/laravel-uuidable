{
    "name": "evanschleret/laravel-uuidable",
    "description": "Add UUID generation, query scopes, and UUID-aware route binding to Eloquent models.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Evan Schleret",
            "homepage": "https://github.com/EvanSchleret"
        }
    ],
    "keywords": [
        "eloquent",
        "laravel",
        "ordered-uuid",
        "uuid",
        "uuidv1",
        "uuidv4",
        "uuidv6",
        "uuidv7"
    ],
    "require": {
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "php": "^8.3",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "EvanSchleret\\LaravelUuidable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EvanSchleret\\LaravelUuidable\\LaravelUuidableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
